{
  "name": "@orvia/theme",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./theme.css": "./theme.css"
  },
  "files": ["dist", "theme.css"],
  "scripts": {
    "build": "tsx scripts/build-css.ts && tsup src/index.ts --format cjs,esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
