{
  "name": "orvia",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p apps/api/tsconfig.scripts.json && tsc -p tsconfig.tools.json",
    "lint": "eslint .",
    "db:push": "pnpm --filter @orvia/db push",
    "db:studio": "pnpm --filter @orvia/db studio",
    "theme:build": "pnpm --filter @orvia/theme build",
    "test:e2e": "DATABASE_URL=postgresql://postgres@localhost:5432/orvia_test tsx --env-file=apps/api/.env tools/e2e/live-loop.e2e.ts",
    "test:browser": "DATABASE_URL=postgresql://postgres@localhost:5432/orvia_test tsx --env-file=apps/api/.env tools/e2e/browser.e2e.ts",
    "test:assignment": "DATABASE_URL=postgresql://postgres@localhost:5432/orvia_test tsx --env-file=apps/api/.env tools/e2e/assignment.e2e.ts",
    "test:conversation": "DATABASE_URL=postgresql://postgres@localhost:5432/orvia_test tsx --env-file=apps/api/.env tools/e2e/conversation.e2e.ts",
    "api:test": "DATABASE_URL=postgresql://postgres@localhost:5432/orvia_test DATA_DIR=./data-test node apps/api/dist/main.js",
    "db:backup": "bash tools/backup-db.sh",
    "db:prune": "bash tools/backup-db.sh --prune-only",
    "test:drill": "DATABASE_URL=postgresql://postgres@localhost:5432/orvia_test tsx --env-file=apps/api/.env tools/e2e/drill.e2e.ts",
    "test:loop": "DATABASE_URL=postgresql://postgres@localhost:5432/orvia_test tsx --env-file=apps/api/.env tools/e2e/loop.e2e.ts",
    "test:deaf": "DATABASE_URL=postgresql://postgres@localhost:5432/orvia_test tsx --env-file=apps/api/.env tools/e2e/deaf.e2e.ts",
    "test:resumption": "DATABASE_URL=postgresql://postgres@localhost:5432/orvia_test tsx --env-file=apps/api/.env tools/e2e/resumption.e2e.ts",
    "test:practice": "tsx tools/verify-practice.mts",
    "test:feed": "DATABASE_URL=postgresql://postgres@localhost:5432/orvia_test tsx --env-file=apps/api/.env tools/e2e/feed.e2e.ts",
    "test:replay": "DATABASE_URL=postgresql://postgres@localhost:5432/orvia_test tsx --env-file=apps/api/.env tools/verify-replay.mts",
    "scrape:premium": "tsx tools/scrape-premium.mts",
    "audio:status": "tsx tools/archive-audio.mts --status",
    "test:archive": "DATABASE_URL=postgresql://postgres@localhost:5432/orvia_test tsx --env-file=apps/api/.env tools/e2e/archive-playback.e2e.ts",
    "test:archive-integration": "DATABASE_URL=postgresql://postgres@localhost:5432/orvia_test tsx --env-file=apps/api/.env tools/e2e/archive-integration.e2e.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@google/genai": "^2.20.0",
    "@types/node": "^24.19.0",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "playwright": "^1.56.1",
    "postgres": "^3.4.7",
    "tsx": "^4.20.6",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "ws": "^8.18.3"
  }
}
