# Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Postgres
DATABASE_URL=postgresql://postgres@localhost:5432/orvia

# API
PORT=8787
WEB_ORIGIN=http://localhost:5173

# Where session audio + raw transcripts are written
DATA_DIR=./data

# Generate with: openssl rand -base64 48
JWT_SECRET=

# ── Cloudflare R2 (optional) ─────────────────────────────────────────────────
# Archives finished rounds as FLAC and frees the local WAVs. Leave these blank
# and nothing changes: every recording stays on local disk, which is how the
# app worked before archiving existed.
#
# Use a BUCKET-SCOPED R2 API token from your own Cloudflare account. These are
# passed explicitly to our own signer (src/storage/sigv4.ts); never introduce an
# S3 SDK here, because it resolves credentials from the ambient chain and
# AWS_PROFILE may point at an unrelated account.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# The Cloudflare login that owns the bucket. `pnpm audio:status` checks
# `wrangler whoami` against it before any R2 call.
R2_ACCOUNT_EMAIL=
