/**
 * The curated banks for the three SPOKEN rounds — core concepts, behavioural,
 * and HR/negotiation.
 *
 * These are committed in-repo rather than ingested, and that is a deliberate
 * split from `question-bank.seed.json`: that file is a SNAPSHOT of what
 * `ingest` pulled from LeetCode and is regenerated by `export-seed`, so
 * anything hand-written there would be destroyed on the next refresh. Nothing
 * upstream serves behavioural questions or a salary negotiation script, so
 * this file IS the source of truth for them. Edit it directly and re-seed.
 *
 * Three rules the content has to keep obeying:
 *
 *   1. **Every prompt is READ ALOUD.** No markdown, no lists, no code, no
 *      symbols. Numbers as words — "ninety-nine point nine", not "99.9". A
 *      prompt that looks fine on the page and sounds absurd spoken is a bug.
 *   2. **`probes` go to the INTERVIEWER; `expectedPoints`, `commonMistakes`,
 *      `strongAnswer` and `rubricNotes` go ONLY to the evaluator.** Probes are
 *      questions, so handing them over does not breach the rule that the
 *      interviewer must never know what a good answer looks like. The other
 *      three are answers, and an interviewer holding them will leak them.
 *   3. **Ids are stable.** They are written into `sessions.config` and into
 *      `question_outcomes`, so renaming one orphans a round's history.
 */

export type ConceptTopicSeed = {
  id: string;
  label: string;
  blurb: string;
};

export type ConceptQuestionSeed = {
  id: string;
  topic: string;
  title: string;
  difficulty: 'easy' | 'medium' | 'hard';
  prompt: string;
  probes: string[];
  expectedPoints: string[];
  commonMistakes: string[];
};

export type BehaviouralCompetencySeed = {
  id: string;
  label: string;
  blurb: string;
};

export type BehaviouralQuestionSeed = {
  id: string;
  competency: string;
  title: string;
  prompt: string;
  probes: string[];
  strongAnswer: string[];
};

export type HrBeat = {
  /** Short name for the beat, used by the interviewer to keep its place. */
  beat: string;
  /** What it puts to the candidate. */
  ask: string;
  /** How it pushes when the candidate deflects or gives ground. */
  pressure: string;
};

export type HrScenarioSeed = {
  id: string;
  title: string;
  blurb: string;
  stage: 'recruiter_screen' | 'offer_negotiation' | 'counter_offer' | 'exit';
  persona: string;
  beats: HrBeat[];
  rubricNotes: string[];
};

