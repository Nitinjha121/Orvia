/**
 * ─────────────────────────────────────────────────────────────────────────────
 *  CURATED COMPANY LISTS
 * ─────────────────────────────────────────────────────────────────────────────
 *  LeetCode title slugs, in the order the list should be shown.
 *
 *  Why these are committed here rather than fetched:
 *
 *  LeetCode's own company tags are PREMIUM. `companyTags` is readable
 *  anonymously, but `problemsetQuestionListV2` with a `companyFilter` returns
 *  `totalLength: 0` without a paid session — verified 2026-09-10 — so there is
 *  no anonymous query that yields "Amazon's questions". The alternative was a
 *  third party's public favourite list (the `sourceRef` slugs the NeetCode and
 *  Google lists use), which puts the contents of our bank inside someone
 *  else's account: they can edit it, unpublish it, or delete it, and a re-ingest
 *  would then silently shrink a list.
 *
 *  So the slugs live here, in review, and `ingest` resolves each one through
 *  the same public `question(titleSlug:)` query that already supplies every
 *  statement and starter skeleton. Adding or removing a problem is a diff.
 *
 *  Every slug below was verified against LeetCode on 2026-09-10: all resolve
 *  and none are paid-only. Ingest re-checks anyway and reports what it dropped,
 *  because a problem can be pulled or moved behind the paywall later — a
 *  paid-only problem has no readable statement, and the title-only fallback
 *  makes a poor interview question.
 * ─────────────────────────────────────────────────────────────────────────────
 */

export type CompanyList = {
  /** Collection id, and the argument `pnpm ingest <name>` takes. */
  name: string;
  label: string;
  blurb: string;
  /** LeetCode title slugs, in list order. */
  slugs: readonly string[];
};

